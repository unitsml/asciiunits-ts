{
  "name": "asciiunits",
  "version": "0.1.0",
  "description": "TypeScript runtime for the asciiunits PARG artifact: load the checksummed grammar artifact and parse UnitsML AsciiUnits expressions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test",
    "replay": "node scripts/replay-corpus.ts",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "parsanol": "github:suleman-uzair/parsanol-ts#4c61875d96937ed228d5344de70beb7999388e2e"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitsml/asciiunits-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./artifacts/unitsml.json": "./artifacts/unitsml.json"
  },
  "engines": {
    "node": ">=24"
  }
}
