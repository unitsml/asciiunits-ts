ression: branches 3 and 4 are order-dependent (shared first bytes; ordered choice is decisive)"]},"default_entry":"expression","render":{},"derive":{},"tests":[{"entry":"expression","kind":"accept","input":"mm*s^-2","expect":{}},{"entry":"expression","kind":"accept","input":"sqrt(Hz)","expect":{}},{"entry":"expression","kind":"accept","input":"K/(kg*m)","expect":{}},{"entry":"expression","kind":"accept","input":"p-","expect":{}},{"entry":"expression","kind":"accept","input":"(m)(s)","expect":{}},{"entry":"expression","kind":"accept","input":"dB","expect":{}},{"entry":"expression","kind":"accept","input":"dB^2","expect":{}},{"entry":"expression","kind":"accept","input":"mbar*s^-2","expect":{}},{"entry":"expression","kind":"accept","input":"kgf","expect":{}},{"entry":"expression","kind":"accept","input":"sqrt(sqrt(m))","expect":{}},{"entry":"expression","kind":"reject","input":"que?","expect":{}},{"entry":"expression","kind":"reject","input":"m2","expect":{}},{"entry":"expression","kind":"reject","input":"dim_Ldim_M","expect":{}},{"entry":"expression","kind":"reject","input":"mm*","expect":{}},{"entry":"expression","kind":"reject","input":"m*s/","expect":{}},{"entry":"expression","kind":"reject","input":"sqrt(m)^2","expect":{}}],"docs":{},"source":"# UnitsML AsciiUnits expression grammar.\n#\n# 1:1 transcription of unitsml-ruby lib/unitsml/parse.rb +\n# lib/unitsml/intermediate_exp_rules.rb (Parslet), rule for rule, in the\n# same alternative order — PEG ordered choice makes order decisive, and the\n# quirks (trailing-extender acceptance, guard fall-through to prefixed\n# units, no power after fenced/sqrt forms) are load-bearing.\n#\n# Terminal tables are generated from UnitsDB via scripts/gen_tables.rb and\n# embedded in the artifact at compile time.\n#\n# Capture names (unit, prefix, dimension, integer, power_numerator, extender,\n# sqrt, int_exp, sequence, first_set, second_set, open_paren, close_paren)\n# mirror the Parslet .as() names so consumers can map them 1:1.\n\ngrammar UnitsmlAscii version \"0.1.0\" edition 2 {\n\n  ws = %x09 / %x0A / %x0B / %x0C / %x0D / %x20\n  spaces = 1*ws\n  lparen = \"(\"\n  rparen = \")\"\n  hyphen = \"-\"\n  star = \"*\"\n  digit = %x30-39\n  forward_slashes = \"//\" / \"/\"\n  extender = (forward_slashes / star) as extender\n  # The signed run is one authored capture: edition 2 drops anonymous\n  # literals from the tree, so the \"-\" sign would vanish and the digits\n  # would name per-iteration — the capture keeps the exact v1 slice\n  # (value \"-2\", \"1/2\", offset..length) the tree readers scalarize.\n  slashed_number = (([\"-\"] 1*digit) [forward_slashes ([\"-\"] 1*digit)]) as integer\n  end_guard = !ANY / &(extender / lparen / rparen / spaces)\n\n  unit = alt from_table \"units\" column \"name\" as unit\n  prefixed_units = alt from_table \"prefixed_units\" column \"name\" as unit\n  single_letter_prefixes = alt from_table \"prefixes_single\" column \"name\" as prefix\n  double_letter_prefixes = alt from_table \"prefixes_double\" column \"name\" as prefix\n  dimensions = alt from_table \"dimensions\" column \"name\" as dimension\n\n  power = \"^\" slashed_number_int_exp as power_numerator\n  slashed_number_int_exp = slashed_number / (lparen slashed_number_named_int_exp as int_exp rparen)\n  slashed_number_named_int_exp = (lparen as open_paren slashed_number_int_exp rparen as close_paren) / slashed_number_int_exp\n  unit_and_power = unit [power]\n  sqrt_sequence = \"sqrt\" lparen prefixes_units_int_exp as sqrt rparen\n  sqrt_dimensions = \"sqrt\" lparen dimension_rules_int_exp as sqrt rparen\n  extended_prefixed_units = extender [spaces] prefixes_units_int_exp as sequence\n  powered_dimensions = dimensions [power]\n\n  prefixes_units = (sqrt_sequence [extended_prefixed_units]) / (\"1\" as unit [extended_prefixed_units]) / (unit_and_power extended_prefixed_units) / (unit_and_power end_guard) / (double_letter_prefixes unit_and_power extended_prefixed_units) / (double_letter_prefixes unit_and_power) / (single_letter_prefixes unit_and_power extended_prefixed_units) / (single_letter_prefixes unit_and_power) / (prefixed_units [power] end_guard)\n\n  wrapper_prefixes_units_value = int_exp_prefixes_units / prefixes_units_int_exp\n  int_exp_prefixes_units = lparen [spaces] named_int_exp_prefixes_units as int_exp [spaces] rparen\n  prefixes_units_named_int_exp = (lparen as open_paren [spaces] wrapper_prefixes_units_value as int_exp [spaces] rparen as close_paren)\n  named_int_exp_prefixes_units = (prefixes_units_named_int_exp as int_exp [(prefixes_units_int_exp / extended_prefixed_units)]) / prefixes_units_int_exp\n\n  implicit_extended = (prefixes_units as first_set spaces as extender prefixes_units as second_set) / (int_exp_prefixes_units as first_int_exp_set [spaces] int_exp_prefixes_units as second_int_exp_set) / (prefixes_units as first_set [spaces] int_exp_prefixes_units as second_int_exp_set) / (int_exp_prefixes_units as first_int_exp_set [spaces] prefixes_units as second_set)\n\n  prefixes_units_int_exp = (implicit_extended as implicit_extended [spaces] [prefixes_units_int_exp as sequence]) / (implicit_extended as implicit_extended [spaces] extender [spaces] prefixes_units_int_exp as sequence) / (int_exp_prefixes_units [spaces] extender [spaces] prefixes_units_int_exp as sequence) / (prefixes_units [spaces] extender [spaces] prefixes_units_int_exp as sequence) / (int_exp_prefixes_units [prefixes_units_int_exp as sequence]) / (prefixes_units [prefixes_units_int_exp as sequence])\n\n  dimension_rules = (sqrt_dimensions / powered_dimensions) [extended_dimension_rules]\n  extended_dimension_rules = [spaces] extender [spaces] dimension_rules_int_exp as sequence\n  int_exp_dimension_rules = lparen dimension_rules_named_exp as int_exp rparen [extended_dimension_rules]\n  dimension_rules_named_exp = ((lparen as open_paren dimension_rules_int_exp as int_exp rparen as close_paren) as int_exp [spaces] (dimension_rules_int_exp / extended_dimension_rules) as sequence) / dimension_rules_int_exp\n\n  dimension_rules_int_exp = (dimension_rules as first_set spaces as extender dimension_rules as second_set [dimension_rules_int_exp]) / (dimension_rules as first_set [spaces] int_exp_dimension_rules as second_int_exp_set [dimension_rules_int_exp]) / (int_exp_dimension_rules as first_int_exp_set [spaces] dimension_rules as second_set [dimension_rules_int_exp]) / (int_exp_dimension_rules as first_int_exp_set [spaces] int_exp_dimension_rules as second_int_exp_set [dimension_rules_int_exp]) / int_exp_dimension_rules / dimension_rules\n\n  expression = prefixes_units_int_exp / dimension_rules_int_exp / (single_letter_prefixes hyphen) / (double_letter_prefixes hyphen)\n\n  entry expression: expression\n\n  test expression {\n    accept \"mm*s^-2\"\n    accept \"sqrt(Hz)\"\n    accept \"K/(kg*m)\"\n    accept \"p-\"\n    accept \"(m)(s)\"\n    accept \"dB\"\n    accept \"dB^2\"\n    accept \"mbar*s^-2\"\n    accept \"kgf\"\n    accept \"sqrt(sqrt(m))\"\n    reject \"que?\"\n    reject \"m2\"\n    reject \"dim_Ldim_M\"\n    reject \"mm*\"\n    reject \"m*s/\"\n    reject \"sqrt(m)^2\"\n  }\n}\n","source_hash":"7702a1bd52072d5d860e8176b50b5bebb218c1fda864592bb7313419e94506e3","unicode_tables":"onigmo (Ruby 3.4.8)","compiler_version":"1.3.113","edition":2,"checksum":"sha256:aa22618c80dc02f3fe1edf2c798dbe34aceae5f4d84524ff98f76a2b91af151d"}
